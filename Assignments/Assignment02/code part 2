#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Ingrese n: ";
    cin >> n;

    long long a = 0, b = 1, sig;
    if (n == 0) { cout << a; return 0; }

    cout << a << " " << b;
    for (int i = 2; i <= n; i++) {
        sig = a + b;
        cout << " " << sig;
        a = b;
        b = sig;
    }
    cout << endl;
    return 0;
}
